{
  "extends": "astro/tsconfigs/strictest",
  "include": [
    ".astro/types.d.ts",
    "src",
    "test"
  ],
  "exclude": [
    "dist"
  ],
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "erasableSyntaxOnly": true,
    "exactOptionalPropertyTypes": false,
    "types": [
      "node"
    ],
    "resolveJsonModule": true
  }
}