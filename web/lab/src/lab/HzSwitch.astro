---
/** Review-only control for the Horizon variants. Not part of the product. */
const { current } = Astro.props as { current: string };
const items = [['/', 'Guide'], ['/lab/1', 'Original'], ['/lab/horizon/shadow', 'Shadow'], ['/lab/horizon/spectrum', 'Spectrum'], ['/lab/horizon/observatory', 'Observatory']];
---
<nav aria-label="Horizon variants">{items.map(([h, l]) => <a href={h} aria-current={h.endsWith(current) ? 'page' : undefined}>{l}</a>)}</nav>
<style>
  nav { position: fixed; z-index: 99; bottom: 14px; left: 50%; translate: -50% 0; display: flex; background: #fff; font: 600 12px/1 system-ui, sans-serif; box-shadow: 0 6px 30px #0009; }
  a { color: #111; text-decoration: none; padding: 11px 13px; } a:hover { background: #ddd; } a[aria-current] { background: #111; color: #fff; }
  @media (max-width: 480px) { a { padding-inline: 8px; font-size: 11px; } }
</style>
