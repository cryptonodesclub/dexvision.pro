---
import '@fontsource-variable/anybody/standard.css';
import '@fontsource-variable/martian-mono/standard.css';
import { TABS, WINDOWS } from './market';
import { PALETTES } from './palettes';

/** The Horizon cover. Same composition for every palette; default tokens are Ember. */
const { palette = 'ember', title = 'DexVision Horizon', engine = 'full' } = Astro.props as { palette?: string; title?: string; engine?: 'full' | 'lite' };
const pal = PALETTES.find((p) => p.id === palette)!;
const vars = Object.entries(pal.css).map(([k, v]) => `--${k}:${v}`).join(';');
---
<!doctype html>
<html lang="en" data-palette={pal.id} data-engine={engine} style={vars || undefined}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title}</title>
</head>
<body>
  <canvas id="hole" aria-hidden="true"></canvas>
  <header>
    <a class="mark" href="#top">DexVision</a>
    <label class="search"><span class="vh">Search pairs</span><input data-search id="q" type="search" placeholder="Token or realm path" autocomplete="off" /><kbd>/</kbd></label>
    <p class="block"><b>gnoland-1</b> block <span id="height">0</span></p>
  </header>

  <main id="top">
    <section class="hero">
      <h1 aria-label="Watch price bend"><span>Watch</span><span>price</span><span>bend</span></h1>
      <p class="lede">Every pair on gno.land. The more it trades, the closer it orbits. <b class="up">{pal.up} is coming toward you.</b> <b class="down">{pal.down} is leaving.</b></p>
      <dl class="chain" id="chain"></dl>
    </section>
    <div id="orbit" class="orbit" aria-label="Trending pairs in orbit"></div>

    <section class="market">
      <div class="bar">
        <div class="tabs" role="group" aria-label="View">{TABS.map((t, i) => <button data-tab={t.id} aria-pressed={i === 0 ? 'true' : 'false'}>{t.label}</button>)}</div>
        <div class="wins" role="group" aria-label="Time window">{WINDOWS.map((w) => <button data-win={w.id} aria-pressed={w.id === 'h24' ? 'true' : 'false'}>{w.label}</button>)}</div>
      </div>
      <div class="scroll">
        <table>
          <thead><tr><th class="l">Pair</th><th>Price</th><th class="l sp">Shift <i>{pal.up.toLowerCase()} to {pal.down.toLowerCase()}</i></th><th>Change</th><th>Volume</th><th>Liquidity</th><th>Market cap</th><th>Txns</th><th>Makers</th><th>Age</th></tr></thead>
          <tbody id="rows"></tbody>
        </table>
        <p id="empty" hidden>No pair matches that search. Try a ticker or a path such as gno.land/r/demo.</p>
      </div>
      <p class="note">Simulated figures for design review.</p>
    </section>
  </main>
  <slot />

  <script>
    import { horizon, project, type Scene } from './horizon';
    import { horizonLite } from './horizon-lite';
    import { controls, view, subscribe, tokens, chain, price, usd, num, pct, age, type Token } from './market';
    import { PALETTES } from './palettes';
    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

    /* headline: letters widen with their closeness to the hole */
    const letters: HTMLElement[] = [];
    document.querySelectorAll('h1 span').forEach((w) => {
      const s = w.textContent!; w.textContent = '';
      for (const c of s) { const i = document.createElement('i'); i.textContent = c; i.setAttribute('aria-hidden', 'true'); w.append(i); letters.push(i); }
    });
    let homes: { x: number; y: number }[] = [];
    const measure = () => { letters.forEach((l) => { l.style.fontVariationSettings = ''; l.dataset.v = ''; }); homes = letters.map((l) => { const r = l.getBoundingClientRect(); return { x: r.left + r.width / 2, y: r.top + scrollY + r.height / 2 }; }); };
    const mouse = { x: -9999, y: -9999 };
    let stale = true; // headline needs a new layout
    addEventListener('pointermove', (e) => { mouse.x = e.clientX; mouse.y = e.clientY; stale = true; }, { passive: true });
    addEventListener('scroll', () => { stale = true; }, { passive: true });

    const lite = document.documentElement.dataset.engine === 'lite';
    const scene: Scene = { incl: 0.16, roll: 0.26, zoom: 1.12, dim: 1, off: [0, 0], t: 8, light: PALETTES.find((p) => p.id === document.documentElement.dataset.palette)!.light };
    const place = () => {
      const narrow = innerWidth < 820;
      scene.zoom = narrow ? 0.72 : 1.16 * Math.min(1, (innerWidth * 0.64) / innerHeight);
      scene.off = narrow ? [0, 0.2] : [(innerWidth / innerHeight) * 0.2, 0.13];
    };
    place(); addEventListener('resize', () => { place(); measure(); stale = true; });

    /* orbiting pairs: radius is volume rank, speed is Keplerian */
    const bodies = view('trending', 'h24').slice(0, 7).sort((a, b) => b.vol - a.vol).map((tk, i) => {
      const el = document.createElement('a');
      el.href = '#row-' + tk.sym; el.className = 'body';
      $('orbit').append(el);
      return { tk, el, r: 3.5 + i * 0.72, a: i * 2.4 + 0.4 };
    });
    const label = (b: (typeof bodies)[0]) => {
      const c = b.tk.ch[state.win];
      b.el.className = 'body ' + (c >= 0 ? 'up' : 'down');
      b.el.innerHTML = `<b>${b.tk.sym}</b><span>${pct(c)}</span>`;
    };

    (lite ? horizonLite : horizon)($<HTMLCanvasElement>('hole'), scene, (dt) => {
      const s = Math.min(1, scrollY / innerHeight);
      const hx = innerWidth / 2 + scene.off[0] * innerHeight, hy = innerHeight / 2 - scene.off[1] * innerHeight;
      if (!lite) { scene.incl = 0.16 + s * 0.5; scene.dim = 1 - s * 0.72; } // lite fades the canvas in CSS and keeps its baked camera
      const shown = s < 0.5;
      for (const b of bodies) {
        b.a += dt * 1.1 / Math.pow(b.r, 1.5);
        const p = project(scene, Math.cos(b.a) * b.r, Math.sin(b.a) * b.r);
        const behind = Math.sin(b.a) > 0.2;
        // lensed light hides what passes behind the shadow; keep the copy column clear too
        const hidden = !shown || (behind && Math.hypot(p.x - hx, p.y - hy) < innerHeight * 0.21 * scene.zoom) || (innerWidth > 820 && p.x < innerWidth * 0.42) || p.x > innerWidth - 110;
        b.el.style.transform = `translate(${p.x.toFixed(1)}px,${p.y.toFixed(1)}px) scale(${Math.min(1.15, 15 / p.depth).toFixed(3)})`;
        b.el.style.opacity = hidden ? '0' : behind ? '.6' : '1';
        b.el.style.pointerEvents = hidden ? 'none' : 'auto';
      }
      // relayout of variable type is the main CPU cost: lite only does it when something moved
      if (lite && (!stale || s > 0.75)) return;
      stale = false;
      const q = lite ? 3 : 0.1;
      letters.forEach((l, i) => {
        const h = homes[i]; if (!h) return;
        const y = h.y - scrollY;
        const d = Math.hypot(h.x - hx, (y - hy) * 0.8) / innerWidth;
        const m = Math.exp(-Math.pow(Math.hypot(h.x - mouse.x, y - mouse.y) / 170, 2));
        const pull = Math.max(0, Math.min(1, (0.66 - d) / 0.34));
        const wd = Math.round((52 + pull * 98 - m * 34) / q) * q, wg = Math.round((880 - pull * 420 + m * 300) / (lite ? 12 : 1)) * (lite ? 12 : 1);
        const v = `'wdth' ${wd.toFixed(1)}, 'wght' ${wg}`;
        if (l.dataset.v !== v) { l.dataset.v = v; l.style.fontVariationSettings = v; }
      });
    });
    document.fonts.load('900 40px "Anybody Variable"', 'Watch price bend').then(() => { measure(); stale = true; dispatchEvent(new Event('horizon:redraw')); });

    /* spectrum: three emission lines, displaced from rest by the change */
    const REST = [34, 88, 126];
    const spectrum = (c: number) => {
      const s = Math.max(-30, Math.min(30, Math.sign(c) * Math.log1p(Math.abs(c)) * 5.6));
      return `<svg viewBox="0 0 160 26" width="160" height="26" aria-hidden="true"><rect y="3" width="160" height="20" fill="url(#band)"/>` +
        REST.map((x, i) => { const to = x - s, a = Math.min(x, to), w = Math.abs(s);
          return `<rect x="${a}" y="3" width="${w}" height="20" fill="url(#${c >= 0 ? 'sb' : 'sr'})"/><path d="M${x} 0v26" stroke="#fff" stroke-opacity=".3" stroke-dasharray="2 2"/><path d="M${to} 1v24" stroke="var(--${c >= 0 ? 'up-line' : 'dn-line'})" stroke-width="${i === 1 ? 3 : 2}"/>`; }).join('') + '</svg>';
    };
    const cell = (t: Token) => {
      const c = t.ch[state.win], k = c >= 0 ? 'up' : 'down';
      return `<th scope="row" class="l"><span class="pair"><b>${t.sym}</b><s>${t.quote}</s><em>${t.fee}</em></span><a href="https://${t.realm}" class="realm">${t.realm.replace('gno.land', '')}</a></th>
        <td class="p ${t.dir > 0 ? 'fu' : t.dir < 0 ? 'fd' : ''}">${price(t.price)}</td><td class="l sp">${spectrum(c)}</td><td class="c ${k}">${pct(c)}</td>
        <td>${usd(t.vol)}</td><td>${usd(t.liq)}</td><td>${usd(t.mcap)}</td><td>${num(t.tx)}</td><td>${num(t.makers)}</td><td>${age(t.age)}</td>`;
    };
    function render() {
      const list = view(state.tab, state.win, state.q);
      $('rows').innerHTML = list.map((t) => `<tr id="row-${t.sym}">${cell(t)}</tr>`).join('');
      $('empty').hidden = list.length > 0;
      bodies.forEach(label); stats();
    }
    function stats() {
      $('height').textContent = num(chain.height);
      $('chain').innerHTML = [['24h volume', usd(chain.vol)], ['Liquidity', usd(chain.liq)], ['24h txns', num(chain.tx)], ['Pairs', String(tokens.length)]].map(([k, v]) => `<div><dt>${k}</dt><dd>${v}</dd></div>`).join('');
    }
    const state = controls(render);
    render();
    subscribe((changed) => {
      tokens.forEach((t) => { if (!changed.includes(t)) t.dir = 0; });
      changed.forEach((t) => { const r = document.getElementById('row-' + t.sym); if (r) r.innerHTML = cell(t); });
      bodies.forEach(label); stats();
    });
  </script>
  <svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs>
    <linearGradient id="band"><stop style="stop-color:var(--band-a)" stop-opacity=".34"/><stop offset=".45" style="stop-color:var(--band-b)" stop-opacity=".12"/><stop offset=".7" style="stop-color:var(--band-c)" stop-opacity=".22"/><stop offset="1" style="stop-color:var(--band-d)" stop-opacity=".36"/></linearGradient>
    <linearGradient id="sb"><stop style="stop-color:var(--up-fill)" stop-opacity=".85"/><stop offset="1" style="stop-color:var(--up-fill)" stop-opacity="0"/></linearGradient>
    <linearGradient id="sr"><stop style="stop-color:var(--dn-fill)" stop-opacity="0"/><stop offset="1" style="stop-color:var(--dn-fill)" stop-opacity=".85"/></linearGradient>
  </defs></svg>
</body>
</html>

<style is:global>
  /* Layout: the hole is the page's light source; type bends toward it, data lies flat beneath it. */
  :root {
    --void: #070405; --ink: #ffefdc; --ash: #b39d92; --ember: #ff7a24; --blue: #7cc0ff; --red: #ff5a42;
    --rule: #ffb27a2e;
    --band-a: #5fb0ff; --band-b: #ffe9d0; --band-c: #ff7a24; --band-d: #ff2a1c; --up-fill: #6fb7ff; --dn-fill: #ff4a33; --up-line: #a9d8ff; --dn-line: #ff8a72;
    --display: 'Anybody Variable', 'Arial Black', sans-serif;
    --data: 'Martian Mono Variable', ui-monospace, monospace;
    --gut: max(16px, 3.2vw);
    color-scheme: dark;
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { margin: 0; background: var(--void); color: var(--ink); font: 400 13px/1.5 var(--data); font-stretch: 85%; }
  a { color: inherit; } :focus-visible { outline: 2px solid var(--blue); outline-offset: 3px; }
  .vh { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  .up { color: var(--blue); } .down { color: var(--red); }
  #hole { position: fixed; inset: 0; width: 100%; height: 100%; }
  #hole[data-failed] { background: radial-gradient(circle at 68% 37%, #000 0 11%, var(--ink) 11.4%, var(--ember) 15%, color-mix(in srgb, var(--ember) 25%, #000) 26%, transparent 44%); }
  header { position: relative; z-index: 3; display: flex; align-items: center; gap: 28px; padding: 22px var(--gut); }
  .mark { font: 800 22px/1 var(--display); font-variation-settings: 'wdth' 150; text-decoration: none; }
  .search { margin-left: auto; position: relative; flex: 0 1 300px; min-width: 0; }
  .search input { width: 100%; font: inherit; color: var(--ink); background: color-mix(in srgb, var(--void) 60.0%, transparent); border: 0; border-bottom: 1px solid var(--ember); padding: 9px 30px 9px 4px; border-radius: 0; }
  .search input::placeholder { color: var(--ash); }
  kbd { position: absolute; right: 6px; top: 9px; font: inherit; color: var(--ember); pointer-events: none; }
  .block { margin: 0; color: var(--ash); font-size: 12px; white-space: nowrap; font-variant-numeric: tabular-nums; } .block b { color: var(--ink); font-weight: 500; }

  .hero { position: relative; z-index: 1; padding: clamp(8px, 2.2vh, 30px) var(--gut) 34px; pointer-events: none; }
  h1 { margin: 0; font: 900 clamp(70px, 10.4vw, 200px)/.9 var(--display); letter-spacing: -.015em; display: flex; flex-direction: column; }
  h1 span { white-space: nowrap; } h1 i { font-style: normal; display: inline-block; will-change: font-variation-settings; }
  h1 span:nth-child(3) { color: var(--ember); margin-top: .1em; }
  .lede { max-width: 46ch; margin: 30px 0 22px; font-size: 15px; line-height: 1.6; text-shadow: 0 0 14px #000, 0 0 4px #000; } .lede b { font-weight: 500; }
  .chain { display: flex; flex-wrap: wrap; gap: 8px 34px; margin: 0; font-variant-numeric: tabular-nums; }
  .chain dt { color: var(--ash); font-size: 11px; } .chain dd { margin: 0; font-size: 18px; font-weight: 500; text-shadow: 0 0 10px #000; }

  .orbit { position: fixed; inset: 0; z-index: 2; pointer-events: none; overflow: hidden; }
  .body { position: absolute; left: 0; top: 0; transform-origin: 0 0; text-decoration: none; white-space: nowrap; display: flex; gap: 8px; padding: 4px 8px 4px 16px; margin: -13px 0 0 -6px; font-size: 12px; background: color-mix(in srgb, var(--void) 91.0%, transparent); transition: opacity .4s; }
  .body::before { content: ''; position: absolute; left: 2px; top: 9px; width: 8px; height: 8px; border-radius: 50%; background: currentColor; box-shadow: 0 0 14px 3px currentColor; }
  .body b { color: #fff; font-weight: 700; } .body:hover { background: var(--void); z-index: 2; }

  .market { position: relative; z-index: 3; background: linear-gradient(color-mix(in srgb, var(--void) 0.0%, transparent), color-mix(in srgb, var(--void) 90.2%, transparent) 70px, color-mix(in srgb, var(--void) 94.9%, transparent)); padding: 34px var(--gut) 90px; }
  .bar { display: flex; flex-wrap: wrap; gap: 10px 30px; align-items: end; justify-content: space-between; padding-bottom: 14px; }
  .tabs, .wins { display: flex; flex-wrap: wrap; gap: 2px 22px; }
  button { font: 700 17px/1 var(--display); font-variation-settings: 'wdth' 75; color: var(--ash); background: none; border: 0; padding: 8px 0; cursor: pointer; transition: font-variation-settings .35s, color .2s; }
  button:hover { color: var(--ink); } button[aria-pressed='true'] { color: var(--ink); font-variation-settings: 'wdth' 150; }
  .wins button { font: 500 13px/1 var(--data); } .wins button[aria-pressed='true'] { color: var(--ember); }
  .scroll { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums; white-space: nowrap; }
  th, td { text-align: right; padding: 11px 14px; font-weight: 400; } .l { text-align: left; } th:first-child { padding-left: 0; } td:last-child, th:last-child { padding-right: 0; }
  thead th { color: var(--ash); font-size: 11px; border-bottom: 1px solid var(--ember); } thead i { font-style: normal; opacity: .75; margin-left: 6px; }
  tbody tr { border-bottom: 1px solid var(--rule); } tbody tr:hover, tbody tr:target { background: linear-gradient(90deg, color-mix(in srgb, var(--ember) 25.1%, transparent), color-mix(in srgb, var(--ember) 0.0%, transparent)); }
  .pair { display: flex; align-items: baseline; gap: 8px; } .pair b { font: 800 19px/1.1 var(--display); font-variation-settings: 'wdth' 110; }
  .pair s { text-decoration: none; color: var(--ash); } .pair em { font-style: normal; font-size: 10px; color: var(--ember); }
  .realm { color: var(--ash); font-size: 11px; text-decoration: none; } .realm:hover { color: var(--ink); text-decoration: underline; }
  .p { font-size: 15px; } .c { font-size: 15px; font-weight: 600; } .sp svg { display: block; }
  @keyframes fu { from { color: var(--blue); text-shadow: 0 0 18px var(--blue); } } @keyframes fd { from { color: var(--red); text-shadow: 0 0 18px var(--red); } }
  .fu { animation: fu 1s; } .fd { animation: fd 1s; }
  #empty { padding: 30px 0; color: var(--ash); } .note { color: var(--ash); font-size: 11px; margin: 18px 0 0; }
  /* gnoland has no second hue for losses, so direction is also drawn */
  [data-palette='gnoland'] td.c.up::before, [data-palette='gnoland'] .body.up span::before { content: '▲ '; font-size: .75em; }
  [data-palette='gnoland'] td.c.down::before, [data-palette='gnoland'] .body.down span::before { content: '▼ '; font-size: .75em; }
  /* lite: opaque data area so the compositor skips the canvas under it; no animated shadows */
  [data-engine='lite'] .market { background: linear-gradient(color-mix(in srgb, var(--void) 0%, transparent), var(--void) 90px); }
  [data-engine='lite'] .body::before { box-shadow: 0 0 0 3px color-mix(in srgb, currentColor 30%, transparent); }
  [data-engine='lite'] .body { will-change: transform; }
  [data-engine='lite'] h1 i { will-change: auto; }
  @keyframes lu { from { color: var(--blue); } } @keyframes ld { from { color: var(--red); } }
  [data-engine='lite'] .fu { animation-name: lu; } [data-engine='lite'] .fd { animation-name: ld; }
  @media (max-width: 820px) {
    header { flex-wrap: wrap; gap: 12px; } .search { order: 3; flex-basis: 100%; } .block { margin-left: auto; }
    .hero { padding-top: 40vh; } h1 { font-size: 19vw; } .body:nth-child(n+5) { display: none; } th, td { padding-inline: 10px; }
  }
  @media (prefers-reduced-motion: reduce) { *, *::before { animation: none !important; transition: none !important; } html { scroll-behavior: auto; } }
</style>
