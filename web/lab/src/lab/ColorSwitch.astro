---
/** Review-only control for the color themes. Not part of the product. */
import { PALETTES } from './palettes';
const { current, lite = false } = Astro.props as { current: string; lite?: boolean };
const full = (id: string) => (id === 'ember' ? '/lab/1' : `/lab/color/${id}`);
---
<nav class="lab-switch" aria-label="Color themes">
  <a href="/">Guide</a>
  {PALETTES.map((p) => <a href={lite ? `/lab/lite/${p.id}` : full(p.id)} aria-current={p.id === current ? 'page' : undefined}>{p.id === 'ember' && !lite ? 'Original' : p.name}</a>)}
  <a href={lite ? full(current) : `/lab/lite/${current}`}>{lite ? 'Full engine' : 'Lite engine'}</a>
</nav>
<style>
  .lab-switch { position: fixed; z-index: 99; bottom: 14px; left: 50%; translate: -50% 0; display: flex; background: #fff; font: 600 12px/1 system-ui, sans-serif; box-shadow: 0 6px 30px #0009; }
  a { color: #111; text-decoration: none; padding: 11px 13px; } a:hover { background: #ddd; } a { white-space: nowrap; } @media (max-width: 560px) { .lab-switch { max-width: 100vw; overflow-x: auto; } a { padding-inline: 8px; font-size: 11px; } } a[aria-current] { background: #111; color: #fff; }
</style>
